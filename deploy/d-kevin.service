[Unit]
Description=D-Kevin Guestbook (Flask + gunicorn)
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/d-kevin
EnvironmentFile=/opt/d-kevin/.env
ExecStart=/opt/d-kevin/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8080 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
